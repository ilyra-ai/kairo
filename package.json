{
  "name": "kairo",
  "version": "1.0.0",
  "private": true,
  "description": "Kairo — Domine o Seu Tempo. Dashboard premium de foco e produtividade com backend Express, SQLite, agenda multilayout e modo foco inclusivo (TDAH/TEA).",
  "main": "src/server/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\" \"tests/migration/*.test.js\" \"tests/frontend/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:migration": "node --test \"tests/migration/*.test.js\"",
    "test:frontend": "node --test \"tests/frontend/*.test.js\"",
    "test:e2e": "playwright test",
    "check:e2e": "npm run test:e2e",
    "coverage": "c8 --all --src=src/server --exclude=tests/** --exclude=src/server/index.js --exclude=src/server/runtime.js --reporter=text --reporter=lcov --check-coverage --lines=80 --functions=90 --branches=75 --statements=80 node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\" \"tests/migration/*.test.js\"",
    "test:coverage": "npm run coverage",
    "check:syntax": "node --check src/server/index.js && node --check public/assets/js/app.js",
    "security:repository": "node scripts/quality/verify-repository.mjs",
    "security:audit": "npm audit",
    "check": "npm run lint && npm run format:check && npm run check:syntax && npm test && npm run coverage && npm run security:repository",
    "check:full": "npm run check && npm run check:e2e"
  },
  "engines": {
    "node": "^20.9.0 || >=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.61.0",
    "c8": "^11.0.0",
    "eslint": "^9.39.3",
    "globals": "^17.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2"
  }
}
