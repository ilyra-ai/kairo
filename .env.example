# =============================================================================
# Kairo — configuração por ambiente
# Copie para .env. Nunca publique o arquivo .env nem segredos reais.
# =============================================================================

# Execução: development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Origens adicionais autorizadas, separadas por vírgula e sem caminho final.
# A própria origem do servidor já é permitida automaticamente.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Ative somente quando houver um proxy reverso confiável configurado.
TRUST_PROXY=false

# =============================================================================
# Sessão e cookie
# =============================================================================

COOKIE_NAME=kairo.session
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
SESSION_TTL_SECONDS=28800

# Em produção, defina um segredo aleatório com no mínimo 32 bytes.
# Formatos aceitos: texto UTF-8, base64:<valor> ou hex:<valor>.
# Em branco, o Kairo gera uma chave local persistida em storage/secrets/.
SESSION_SECRET=

# Chave AES-256 com exatamente 32 bytes para dados sensíveis.
# Em branco, o Kairo gera uma chave local persistida em storage/secrets/.
ENCRYPTION_KEY=

# =============================================================================
# Armazenamento e migração
# =============================================================================

KAIRO_DB_PATH=storage/database/kairo.sqlite

# E-mail de um administrador ativo que receberá dados legados em migrações
# com mais de um administrador possível. Deixe vazio no primeiro bootstrap.
MIGRATION_OWNER_EMAIL=

# Limites de requisição aceitos pelo Express.
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=256kb
AVATAR_BODY_LIMIT=3mb

# =============================================================================
# Google Agenda — OAuth 2.0
# =============================================================================

# 1. Ative a Google Calendar API no Google Cloud.
# 2. Crie credenciais OAuth do tipo "Aplicativo da Web".
# 3. Cadastre exatamente a URI de retorno abaixo nas credenciais.
# IMPORTANTE — configuração pessoal autorizada pelo proprietário:
# não remover, apagar, substituir nem mover estas credenciais sem autorização
# explícita do proprietário do projeto. Este repositório é de uso pessoal.
GOOGLE_CLIENT_ID=318937612007-r02madv3lmq82qtbusesgpq17s5ts1d7.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo

# =============================================================================
# Stripe Billing — assinaturas recorrentes
# =============================================================================

# Mantenha desativado até cadastrar credenciais, Prices mensais em BRL e webhook.
PAYMENTS_ENABLED=false
STRIPE_MODE=test

# Prefira uma chave restrita rk_test_/rk_live_ com somente as permissões necessárias.
# Chaves secretas sk_test_/sk_live_ também são aceitas. Nunca versione valores reais.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# Origem pública do Kairo, sem barra final. Em produção, HTTPS é obrigatório.
STRIPE_PUBLIC_APP_URL=http://127.0.0.1:3000
