# ============================================================================
#  Kairo — Variáveis de Ambiente (copie este arquivo para ".env" e preencha)
# ============================================================================

# Porta do servidor (opcional; padrão 3000)
PORT=3000

# ----------------------------------------------------------------------------
# Integração com o Google Calendar (OAuth 2.0)
#
# Como obter as credenciais:
#   1. Acesse https://console.cloud.google.com/ e crie um projeto.
#   2. Em "APIs e serviços" → "Biblioteca", ative a "Google Calendar API".
#   3. Em "APIs e serviços" → "Tela de consentimento OAuth", configure o app
#      (tipo Externo) e adicione seu e-mail como usuário de teste.
#   4. Em "Credenciais" → "Criar credenciais" → "ID do cliente OAuth" →
#      Tipo "Aplicativo da Web".
#   5. Em "URIs de redirecionamento autorizados", adicione EXATAMENTE:
#      http://localhost:3000/api/google/callback
#   6. Copie o Client ID e o Client Secret gerados para as variáveis abaixo.
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Calendário de destino (opcional; "primary" = agenda principal)
GOOGLE_CALENDAR_ID=primary

# Fuso horário usado ao criar eventos (opcional)
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
