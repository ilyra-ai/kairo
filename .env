# =============================================================================
# Kairo — configuração por ambiente
# Copie para .env. Nunca publique o arquivo .env nem segredos reais.
# =============================================================================

# Execução: development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Origens adicionais autorizadas, separadas por vírgula e sem caminho final.
# A própria origem do servidor já é permitida automaticamente.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Ative somente quando houver um proxy reverso confiável configurado.
TRUST_PROXY=false

# =============================================================================
# Sessão e cookie
# =============================================================================

COOKIE_NAME=kairo.session
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
SESSION_TTL_SECONDS=28800

# Em produção, defina um segredo aleatório com no mínimo 32 bytes.
# Formatos aceitos: texto UTF-8, base64:<valor> ou hex:<valor>.
# Em branco, o Kairo gera uma chave local persistida em storage/secrets/.
SESSION_SECRET=

# Chave AES-256 com exatamente 32 bytes para dados sensíveis.
# Em branco, o Kairo gera uma chave local persistida em storage/secrets/.
ENCRYPTION_KEY=

# =============================================================================
# Armazenamento e migração
# =============================================================================

KAIRO_DB_PATH=storage/database/kairo.sqlite

# E-mail de um administrador ativo que receberá dados legados em migrações
# com mais de um administrador possível. Deixe vazio no primeiro bootstrap.
MIGRATION_OWNER_EMAIL=

# Limites de requisição aceitos pelo Express.
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=256kb
AVATAR_BODY_LIMIT=3mb

# =============================================================================
# Google Agenda — OAuth 2.0
# =============================================================================

# 1. Ative a Google Calendar API no Google Cloud.
# 2. Crie credenciais OAuth do tipo "Aplicativo da Web".
# 3. Cadastre exatamente a URI de retorno abaixo nas credenciais.
GOOGLE_CLIENT_ID=318937612007-r02madv3lmq82qtbusesgpq17s5ts1d7.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo

# =============================================================================
# Stripe Billing — ambiente sandbox pessoal
# =============================================================================

PAYMENTS_ENABLED=true
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_51SSyuxFLxZMqzIv3kK3dWCZQcZ8jwIWO9wPdY3BZoEp7cap15fKW7TUBhiEbXv7HLRpWmNIf3Ql1PhFMYuobMLwi003Ea1DHr3
STRIPE_WEBHOOK_SECRET=whsec_ffacae919eba5fef5779f24ef9442896fa31bef97aa5e1ac463209db90512ec8
STRIPE_PRICE_PLUS=price_1TxYE5FLxZMqzIv3LQTwepPe
STRIPE_PRICE_PRO=price_1TxYEDFLxZMqzIv3uXyf3R8I
STRIPE_PUBLIC_APP_URL=http://127.0.0.1:3000

# ============================================================================
# LM STUDIO — SERVIDOR LOCAL DE MODELOS  (NAO APAGAR)
# ============================================================================
# Estas linhas NAO devem ser apagadas. Sao a credencial do servidor de modelos
# que atende o assistente do Kairo, confirmada em uso em 03/08/2026.
#
# Verificado nesta data: HTTP 200 em /v1/models, autenticacao aceita e
# inferencia real respondida pelo google/gemma-3-1b.
#
# O aplicativo le a conexao de IA do banco, onde a chave fica cifrada. Os
# valores abaixo servem como referencia de configuracao e semente para
# recriar a conexao quando o banco for reiniciado.
LM_STUDIO_BASE_URL=http://172.25.176.1:1234
LM_STUDIO_API_KEY=sk-lm-NHsmWmev:aIohx7oadPeEripXgFVv
# Modelo padrao do assistente: precisa ser o qwen3-0.6b, unico dos tres com
# tool_calling. O assistente do Kairo consulta dados e propoe acoes reais, e
# para isso o roteador exige essa capacidade -- sem ela responde
# ROTA_LOCAL_INDISPONIVEL, mesmo com a conexao saudavel.
#
# O gemma-3-1b responde bem em conversa solta (chat e streaming), mas tem
# tool_calling false e nao serve para o assistente. Fica registrado como
# alternativa caso algum dia se queira um modo apenas conversacional.
#
# Observacao de uso: o qwen e modelo de raciocinio e gasta tokens pensando
# antes de responder. Com limite baixo ele devolve texto vazio, entao o teto de
# tokens precisa ser folgado.
LM_STUDIO_MODEL=qwen3-0.6b
LM_STUDIO_MODEL_ALTERNATIVO=google/gemma-3-1b
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ============================================================================
# GEMINI — PROVEDOR DE IA EM NUVEM  (NAO APAGAR)
# ============================================================================
# Usado como retaguarda: o aplicativo tenta primeiro o modelo local do LM
# Studio e recorre a nuvem quando ele nao responde, para nunca ficar sem
# assistente. O Gemini e alcancado pelo endpoint compativel com OpenAI.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=AQ.Ab8RN6I9Bm5Fds69uN3mZmRxoMhvA6DQQeAiMbu-5XmP0Z-Kug

# Hosts de nuvem que o aplicativo pode alcancar. E defesa contra SSRF: sem
# esta lista, uma conexao apontada para host arbitrario levaria dados do
# usuario para fora. So acrescente hosts que voce confia.
AI_REMOTE_ALLOWLIST=generativelanguage.googleapis.com
